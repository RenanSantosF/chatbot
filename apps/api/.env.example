DATABASE_URL="postgresql://user:password@localhost:5432/chatbot_dev?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001
WEB_APP_URL="http://localhost:3000"

# Chave mestra pra criptografar secrets de tenant (API key da IA, token do
# WhatsApp na Fase 7). Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Cada tenant configura sua própria API key de IA pela tela (/dashboard/ai).
# Estas variáveis são só um fallback opcional pra desenvolvimento local, sem
# precisar configurar uma chave por tenant a cada teste.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

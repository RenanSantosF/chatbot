DATABASE_URL="postgresql://user:password@localhost:5432/chatbot_dev?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001
WEB_APP_URL="http://localhost:3000"

# Chave mestra pra criptografar secrets de tenant (API key da IA, token do
# WhatsApp na Fase 7). Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Cada tenant configura sua própria API key de IA pela tela (/dashboard/ai).
# Estas variáveis são só um fallback opcional pra desenvolvimento local, sem
# precisar configurar uma chave por tenant a cada teste.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# WhatsApp Cloud API (Fase 7). O token/app secret de cada tenant ficam
# configurados pela tela (/dashboard/settings), nunca aqui — estas duas são
# de plataforma:
# - WHATSAPP_VERIFY_TOKEN: valor que você escolhe e cola tanto aqui quanto
#   no campo "Verify token" do webhook de cada app no Meta Developers. É só
#   pra confirmar a URL do webhook, não dá acesso a nada.
# - API_PUBLIC_URL: a URL pública desta API em produção (ex:
#   https://sua-api.onrender.com). Na tela de configurações ela só monta a
#   URL do webhook pra você copiar — mas quem conecta pela Evolution
#   DEPENDE dela: é o endereço que o servidor de mensagens vai chamar
#   quando chegar mensagem. Sem ela, conectar falha na hora, com recado.
WHATSAPP_VERIFY_TOKEN=""
API_PUBLIC_URL=""

# --- Meta como Tech Provider (Embedded Signup) -------------------------
# Preenchidos só na plataforma, uma vez. Com eles, o cliente conecta o
# WhatsApp dele clicando um botão, sem abrir o Meta Developers.
# Sem eles, o botão nem aparece e resta o caminho manual (app próprio).
#
# Exige App Review aprovado com whatsapp_business_messaging e
# whatsapp_business_management.
META_APP_ID=
META_APP_SECRET=
# ID da configuração do Embedded Signup.
#
# O jeito mais rápido de achar os dois IDs não é caçar no menu: na página
# "Fazer a integração como um Provedor de Tecnologia", o botão "Gerar link"
# do Cadastro incorporado devolve uma URL que traz os dois na query —
# `app_id=` e `config_id=`. Os dois são públicos por natureza (viajam no
# navegador do cliente em todo onboarding); o único segredo desta seção é
# o META_APP_SECRET, que sai de Configurações > Básico e não deve ser
# colado em lugar nenhum além daqui.
META_ES_CONFIG_ID=

# --- Armazenamento de anexos (S3 ou compatível) ------------------------
# Sem estas, os anexos seguem vindo da Meta — que os APAGA em 30 dias.
# Com elas, cada anexo recebido é copiado pro bucket da plataforma, sob o
# prefixo da empresa dona da conversa.
#
# Permissões que a chave precisa ter no bucket: PutObject, GetObject e
# DeleteObject. ListBucket é OPCIONAL e serve só à varredura de sobra ao
# encerrar uma conta — sem ela, os anexos conhecidos ainda são apagados
# pela lista gravada no banco, e o log avisa que a varredura não rodou.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Só pra Cloudflare R2, MinIO ou testes. Vazio = AWS S3.
S3_ENDPOINT=
# Só pra apontar num ambiente de teste da Meta. Vazio = produção.
META_GRAPH_URL=

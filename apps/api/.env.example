DATABASE_URL="postgresql://user:password@localhost:5432/chatbot_dev?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001
WEB_APP_URL="http://localhost:3000"

# Chave mestra pra criptografar secrets de tenant (API key da IA, token do
# WhatsApp na Fase 7). Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Cada tenant configura sua própria API key de IA pela tela (/dashboard/ai).
# Estas variáveis são só um fallback opcional pra desenvolvimento local, sem
# precisar configurar uma chave por tenant a cada teste.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# WhatsApp Cloud API (Fase 7). O token/app secret de cada tenant ficam
# configurados pela tela (/dashboard/settings), nunca aqui — estas duas são
# de plataforma:
# - WHATSAPP_VERIFY_TOKEN: valor que você escolhe e cola tanto aqui quanto
#   no campo "Verify token" do webhook de cada app no Meta Developers. É só
#   pra confirmar a URL do webhook, não dá acesso a nada.
# - API_PUBLIC_URL: a URL pública desta API em produção (ex:
#   https://sua-api.onrender.com), usada só pra mostrar a URL do webhook
#   completa na tela de configurações. Sem isso, mostra localhost.
WHATSAPP_VERIFY_TOKEN=""
API_PUBLIC_URL=""

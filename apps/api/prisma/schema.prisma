// Prisma schema — Fase 1 (multi-tenancy + auth) e Fase 2 (clientes, conversas, mensagens).
// Novos módulos (ai, knowledge, queues, etc.) entram nas próximas fases.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  logo      String?
  timezone  String       @default("America/Sao_Paulo")
  language  String       @default("pt-BR")
  status    TenantStatus @default(TRIAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users              User[]
  customers          Customer[]
  conversations      Conversation[]
  messages           Message[]
  aiSettings         AiSettings?
  aiInstructions     AiInstruction[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  aiTools            AiTool[]
  tasks              Task[]
  queues             Queue[]
  queueMembers       QueueMember[]
  routingRules       RoutingRule[]
  rolePermissions    RolePermission[]
  collectionFields   CollectionField[]
  customerNotes      CustomerNote[]
  retention          RetentionSettings?
  billing            BillingAccount?
  inboxSettings      InboxSettings?
  whatsappSettings   WhatsAppSettings?

  @@map("tenants")
}

/// Como o número entrou no sistema.
///
/// MANUAL: o cliente criou o próprio app no Meta Developers e colou os
/// dados. É o caminho de quem já estava aqui antes, e o de quem prefere
/// manter o app próprio.
///
/// EMBEDDED_SIGNUP: o cliente clicou um botão, autorizou pelo Facebook e
/// pronto — nunca abriu o Meta Developers. Exige que a PLATAFORMA seja
/// Tech Provider aprovada pela Meta; o cliente não precisa de nada.
enum WhatsAppOnboarding {
  MANUAL
  EMBEDDED_SIGNUP
}

model WhatsAppSettings {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  // ID do número na Cloud API da Meta — chega em todo webhook recebido
  // (value.metadata.phone_number_id) e é como identificamos de qual tenant
  // é uma mensagem antes mesmo de saber o tenantId, já que o webhook é
  // único pra plataforma inteira. Por isso é globalmente único, não só
  // único por tenant.
  phoneNumberId        String   @unique
  displayPhoneNumber   String?
  wabaId               String?
  accessTokenEncrypted String
  // Opcional desde a entrada por Embedded Signup: nesse caminho quem assina
  // os webhooks é o app da plataforma, com um segredo só, guardado no
  // ambiente. Preenchido apenas por quem conectou o número na mão, com app
  // próprio no Meta Developers.
  appSecretEncrypted   String?
  onboarding           WhatsAppOnboarding @default(MANUAL)
  /** Business portfolio do cliente, devolvido pelo Embedded Signup. */
  businessId           String?
  /** PIN da verificação em duas etapas, definido por nós ao registrar. */
  registrationPinEncrypted String?

  // --- Coexistência (número no aplicativo do celular E na Cloud API).
  //
  // Estes campos não são configuração: são o que a Meta nos contou pelo
  // webhook. Guardamos porque a sincronização do histórico chega picada em
  // dezenas de entregas ao longo de horas, e sem registrar o andamento não
  // há como responder "já acabou?" — nem pra tela, nem pro suporte.
  //
  // A presença de qualquer eco/contato/histórico é o que prova que a
  // coexistência está ativa; não existe endpoint pra perguntar isso.
  coexistenceSeenAt    DateTime?
  /** 0 a 100. Só do histórico anterior ao onboarding. */
  historyProgress      Int       @default(0)
  historySyncedAt      DateTime?
  historyMessages      Int       @default(0)
  /** Motivo de o histórico não vir (ex.: a empresa desligou no aplicativo). */
  historyError         String?
  contactsSyncedAt     DateTime?
  contactsCount        Int       @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

model User {
  id                 String     @id @default(uuid())
  tenantId           String
  name               String
  email              String
  passwordHash       String
  role               UserRole   @default(AGENT)
  avatar             String?
  status             UserStatus @default(ACTIVE)
  // Conta criada pelo dono com senha temporária: o primeiro login obriga a
  // pessoa a definir a própria senha, então a senha que o dono viu deixa
  // de valer e ninguém além do titular a conhece.
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]
  queueMemberships      QueueMember[]
  routingRules          RoutingRule[]
  customerNotes         CustomerNote[]

  // Email é único globalmente (não só por tenant): simplifica o login, que não
  // exige saber a qual empresa o usuário pertence antes de autenticar.
  // Cada usuário pertence a exatamente um tenant no MVP.
  @@unique([email])
  @@index([tenantId])
  @@map("users")
}

model Customer {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  phone      String
  email      String?
  externalId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  notes         CustomerNote[]

  // Telefone é a chave de identificação de um cliente dentro de um tenant
  // (é por onde ele chega pelo WhatsApp), mas o mesmo telefone pode ser
  // cliente de várias empresas diferentes na plataforma.
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

// Preferências de atendimento da empresa, separadas das credenciais do
// canal: valem pra qualquer canal e são o tipo de coisa que o dono mexe
// sem precisar tocar em token nenhum.
enum QueueVisibility {
  ALL
  OWN_QUEUES
}

model InboxSettings {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  // Confirmação de leitura: quando desligada, abrir a conversa no painel
  // não acende o tique azul no aparelho do cliente. É escolha da empresa —
  // tem negócio que prefere não revelar que leu e ainda não respondeu.
  sendReadReceipts Boolean  @default(true)
  // Aviso automático ao resolver: sem isso o cliente fica sem saber que o
  // atendimento foi encerrado e continua esperando resposta.
  notifyOnResolve  Boolean  @default(true)
  resolveMessage   String   @default("Atendimento encerrado por aqui. Se precisar de mais alguma coisa, é só mandar mensagem que a gente volta a te atender.")
  // Agrupar conversas do mesmo cliente: quando ligado, quem volta a
  // escrever depois de um assunto resolvido cai na MESMA conversa, com o
  // histórico anterior à vista, em vez de abrir um card novo do zero.
  // Desligado, cada assunto vira um atendimento separado — que é o que
  // uma operação com métrica por chamado costuma querer.
  /// Deixa responder numa conversa já encerrada. Ligado, enviar reabre o
  /// atendimento automaticamente — é o que a maioria espera, porque o
  /// cliente do outro lado não vê "encerrado", vê uma conversa de WhatsApp.
  /// Desligado, o compositor fica travado e é preciso reabrir de propósito.
  allowSendWhenResolved Boolean @default(true)

  groupByCustomer  Boolean  @default(true)
  // Janela em horas pro reagrupamento. Passou disso, o assunto é outro e
  // a conversa nova começa limpa.
  groupWindowHours Int      @default(72)
  // Encerra sozinho o que ficou parado. Serve pra não deixar assunto
  // pendurado até estourar a janela de 24h de atendimento do WhatsApp,
  // quando responder passa a exigir modelo aprovado (e pago).
  autoCloseIdle    Boolean  @default(false)
  autoCloseHours   Int      @default(20)
  // Assina a mensagem com o nome de quem respondeu ("*Renan:*" em negrito,
  // antes do texto). Desligado por padrão porque é decisão de imagem: tem
  // empresa que quer que o cliente saiba com quem falou, e tem empresa que
  // prefere falar como uma voz só.
  showAgentName    Boolean  @default(false)
  // Quem enxerga o quê no Inbox. ALL: todo mundo vê tudo, que é o certo pra
  // equipe pequena. OWN_QUEUES: cada um vê só os setores de que participa —
  // o financeiro não abre conversa do jurídico. Dono e admin veem tudo nos
  // dois modos, senão não dá pra chefiar.
  queueVisibility  QueueVisibility @default(ALL)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("inbox_settings")
}

/// Anotação interna sobre um cliente. Nunca vai pro cliente.
///
/// Nasceu de uma necessidade concreta do atendimento: "Nilma Transportes,
/// aguardando prazo de coleta das informações". Isso não é mensagem, não é
/// tarefa do sistema e não pertence a uma conversa específica — é memória
/// da relação com aquele cliente, que precisa sobreviver ao fim do assunto
/// e estar à mão de quem pegar a próxima conversa dele.
///
/// Uma anotação vira pendência marcando `isPending`. A diferença é só de
/// estado: pendência aparece em destaque enquanto não for concluída;
/// anotação comum é registro e pronto.
model CustomerNote {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  /// Quem escreveu. Nulo se a pessoa saiu da empresa — a anotação continua
  /// valendo mesmo sem o autor.
  authorId   String?
  content    String
  isPending  Boolean   @default(false)
  dueAt      DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId, createdAt])
  @@map("customer_notes")
}

enum ConversationChannel {
  INTERNAL
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_AGENT
  RESOLVED
  CLOSED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AiMode {
  AI_ACTIVE
  HUMAN_ACTIVE
  AI_ASSIST
  PAUSED
}

model Conversation {
  id                String               @id @default(uuid())
  tenantId          String
  customerId        String
  channel           ConversationChannel  @default(INTERNAL)
  status            ConversationStatus   @default(OPEN)
  assignedUserId    String?
  queueId           String?
  aiMode            AiMode               @default(AI_ACTIVE)
  priority          ConversationPriority @default(NORMAL)
  // Preenchidos pela ferramenta transferToQueue — o "handoff inteligente"
  // do escopo original: por que foi transferida, resumo pra quem for
  // atender não perder contexto, e dados que a IA já coletou do cliente.
  escalationReason  String?
  escalationSummary String?
  collectedData     Json?
  // Não lidas da caixa compartilhada: sobe a cada mensagem do cliente e
  // zera quando alguém abre a conversa. É por conversa e não por usuário
  // porque o Inbox é de time — quando um atendente lê, a conversa está
  // lida pra empresa, igual a uma caixa de e-mail compartilhada.
  unreadCount       Int                  @default(0)

  /// Falso enquanto o responsável indicado ainda não confirmou. Só o
  /// direcionamento automático (regra ou trava da IA) cria conversa nesse
  /// estado: a máquina sugere, a pessoa aceita. Quem assume pelo botão já
  /// entra aceito, porque a escolha foi dela.
  assignmentAccepted Boolean             @default(true)
  lastMessageAt     DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  queue        Queue?    @relation(fields: [queueId], references: [id], onDelete: SetNull)
  messages     Message[]
  tasks        Task[]

  @@index([tenantId, status])
  // Ordenação padrão da lista do Inbox (mais recente primeiro) —
  // sem isso o Postgres ordena a tabela toda a cada página.
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([queueId])
  @@map("conversations")
}

enum MessageSenderType {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  OTHER
}

// Ciclo de vida de entrega de uma mensagem que a empresa mandou. Só faz
// sentido pra mensagens de saída em canais que reportam entrega (hoje só
// WhatsApp) — mensagem de cliente entra direto como SENT e fica assim.
enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id             String            @id @default(uuid())
  tenantId       String
  conversationId String
  senderType     MessageSenderType
  senderId       String?
  content        String
  messageType    MessageType       @default(TEXT)
  status         MessageStatus     @default(SENT)
  // ID da mensagem na Meta (wamid...), devolvido no envio. É por ele que
  // os webhooks de status depois encontram a linha certa pra atualizar.
  externalId     String?
  metadata       Json?
  // ID da mídia na Meta, espelhado pra fora do metadata.
  //
  // Ele continua dentro do JSON (junto do mime, nome e chave do bucket),
  // mas o proxy de anexo procura a mensagem POR ele em toda abertura de
  // conversa e em todo arquivamento vindo do webhook. Buscar por caminho
  // dentro de Json não usa índice: varria a tabela de mensagens inteira do
  // tenant, e essa tabela é a que mais cresce no sistema. Como coluna, a
  // busca é um índice direto.
  mediaId        String?
  // Resposta citada: no WhatsApp o cliente pode responder uma mensagem
  // específica, e sem isso a conversa perde o fio quando ele responde algo
  // de cinco mensagens atrás.
  replyToId      String?
  // Reações (emoji) na mensagem, como {"👍": ["5511..."]}. Guardadas na
  // própria mensagem reagida, não como mensagem nova — é assim que a Meta
  // manda e é assim que faz sentido exibir.
  reactions      Json?
  // Quando alguém apagou a mensagem no painel. Apagamento é lógico: a
  // linha permanece com o conteúdo, porque histórico de atendimento é
  // prova — em cobrança, reclamação ou processo, "sumiu" e "nunca existiu"
  // são coisas diferentes. O painel esconde o conteúdo e mostra a tarja de
  // apagada; quem apagou e quando ficam registrados.
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime          @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([tenantId])
  @@index([conversationId, createdAt])
  @@index([externalId])
  // Composto e nesta ordem: a busca sempre chega com o tenant já fixado
  // pela extensão de isolamento, então o filtro mais seletivo vem primeiro.
  @@index([tenantId, mediaId])
  @@map("messages")
}

// Tipo do dado que a IA precisa coletar — o tipo é o que permite validar
// e, no futuro, formatar (CPF, telefone) em vez de aceitar texto solto.
enum CollectionFieldType {
  TEXT
  EMAIL
  PHONE
  DOCUMENT
  DATE
  NUMBER
}

// Onde o valor coletado é gravado. NAME e EMAIL sobem pro cadastro do
// cliente (deixando o contato com o nome de verdade em vez do que veio do
// perfil do WhatsApp); METADATA fica no bolso livre do cliente.
enum CollectionFieldTarget {
  NAME
  EMAIL
  METADATA
}

// Campo que a IA é obrigada a coletar antes de transferir ou encerrar.
// Diferente das instruções em texto livre: aqui o sistema sabe o que
// falta e cobra, em vez de torcer pra o modelo lembrar.
model CollectionField {
  id          String                @id @default(uuid())
  tenantId    String
  key         String
  label       String
  description String?
  type        CollectionFieldType   @default(TEXT)
  target      CollectionFieldTarget @default(METADATA)
  required    Boolean               @default(true)
  order       Int                   @default(0)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, active])
  @@map("collection_fields")
}

enum AiTone {
  PROFESSIONAL
  FRIENDLY
  CASUAL
  OBJECTIVE
  WARM
}

// Provedores de LLM suportados. Cada um novo (OpenAI, Anthropic...) só
// precisa de um adapter em modules/ai/providers — não muda esse enum de
// lugar nenhum além do binding de DI.
enum AiProviderKind {
  GEMINI
}

// Quanto a IA pode guardar sobre um cliente entre uma conversa e outra.
// É decisão do dono da empresa, não da IA: NONE desliga a ferramenta de
// memória por completo, IMPORTANT_ONLY deixa guardar só o que é preciso
// pra atender de novo (ex: "é advogado", "prefere ser chamado de Dr."),
// e FULL libera detalhes gerais que aparecerem na conversa.
enum AiMemoryMode {
  NONE
  IMPORTANT_ONLY
  FULL
}

// Identidade, comportamento e credencial de IA — uma linha por tenant
// (1:1). Criada com valores padrão junto do tenant no registro (ver
// AuthService.register). Cada empresa usa a própria API key: nunca
// compartilhado entre tenants, nunca em texto puro (ver EncryptionService).
model AiSettings {
  id                 String         @id @default(uuid())
  tenantId           String         @unique
  active             Boolean        @default(true)
  aiName             String         @default("Assistente")
  tone               AiTone         @default(PROFESSIONAL)
  customInstructions String?
  provider           AiProviderKind @default(GEMINI)
  apiKeyEncrypted    String?
  model              String?
  memoryMode         AiMemoryMode   @default(IMPORTANT_ONLY)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// Instrução em linguagem natural que o dono ensina pra IA (ver seção
// "Ensinar a IA" do produto). Entram no prompt ordenadas por prioridade.
model AiInstruction {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  content   String
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("ai_instructions")
}

enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

// Um documento enviado (PDF, DOCX, TXT, CSV, XLSX). O texto extraído vira
// KnowledgeChunk — este model só guarda metadado e status do processamento,
// não o arquivo original (ver decisão de arquitetura no KnowledgeService).
model KnowledgeDocument {
  id           String                  @id @default(uuid())
  tenantId     String
  title        String
  fileName     String
  mimeType     String
  status       KnowledgeDocumentStatus @default(PROCESSING)
  errorMessage String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
  @@map("knowledge_documents")
}

// Pedaço de texto extraído + embedding pra busca semântica (pgvector). O
// campo embedding é Unsupported porque o Prisma Client não modela o tipo
// `vector` nativamente — toda leitura/escrita dele passa por SQL raw
// (ver KnowledgeService), o que também significa que a extensão central de
// isolamento por tenant NÃO protege essas queries automaticamente: todo
// SQL raw aqui precisa filtrar tenantId manualmente, sempre.
model KnowledgeChunk {
  id         String                      @id @default(uuid())
  tenantId   String
  documentId String
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

enum AiToolPermission {
  ALLOW
  DENY
  REQUIRES_APPROVAL
}

// Configuração de uma ferramenta nativa pra este tenant. `key` casa com a
// implementação fixa no registro (ver AiToolsService) — o catálogo de
// ferramentas em si é código, só a permissão/liga-desliga é por tenant.
model AiTool {
  id         String           @id @default(uuid())
  tenantId   String
  key        String
  enabled    Boolean          @default(false)
  permission AiToolPermission @default(REQUIRES_APPROVAL)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("ai_tools")
}

// Regra de "quem atende o quê": o dono descreve o assunto em português e
// escolhe o destino (uma pessoa específica ou uma fila). A descrição é o
// que a IA lê pra escolher a regra certa — por isso ela é texto livre e
// não uma lista fixa de categorias.
model RoutingRule {
  id            String               @id @default(uuid())
  tenantId      String
  key           String
  name          String
  // Quando usar esta regra, em linguagem natural. Vai pro prompt da IA.
  subject       String
  // Prioridade mínima pra regra valer. NORMAL (padrão) = vale sempre;
  // URGENT = só entra quando a conversa foi classificada como urgente,
  // que é como se monta um plantão sem atrapalhar o fluxo do dia a dia.
  minPriority   ConversationPriority @default(NORMAL)
  // Destino: uma pessoa OU uma fila. Pessoa tem precedência quando os
  // dois estão preenchidos.
  targetUserId  String?
  targetQueueId String?
  active        Boolean              @default(true)
  priorityOrder Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUser  User?  @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  targetQueue Queue? @relation(fields: [targetQueueId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([tenantId, active])
  @@map("routing_rules")
}

// O que cada papel pode fazer, ajustável pelo dono. A linha só existe
// quando o dono mexeu no padrão — a ausência significa "vale o padrão do
// código" (ver PERMISSION_DEFAULTS), então ligar o sistema não precisa
// semear nada e um recurso novo já nasce com um padrão sensato.
model RolePermission {
  id        String   @id @default(uuid())
  tenantId  String
  role      UserRole
  key       String
  allowed   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, key])
  @@index([tenantId])
  @@map("role_permissions")
}

enum TaskStatus {
  OPEN
  DONE
}

// Tarefa de acompanhamento pra equipe humana — criada pela ferramenta
// createTask da IA, ou (no futuro) manualmente por um atendente.
model Task {
  id             String     @id @default(uuid())
  tenantId       String
  conversationId String?
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  createdByAi    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([conversationId])
  @@map("tasks")
}

// Fila/departamento pro qual a IA transfere um atendimento (ver
// AiToolsService.transferToQueue). `key` é o identificador estável que a
// IA usa pra escolher a fila certa — dado como enum dinâmico na
// declaração da ferramenta, nunca texto livre adivinhado pelo modelo.
model Queue {
  id                   String   @id @default(uuid())
  tenantId             String
  key                  String
  name                 String
  description          String?
  // Ponteiro do rodízio: id do último membro que recebeu uma conversa
  // desta fila. Sem relação formal de propósito — é só um bookmark, não
  // precisa de integridade referencial (se o membro sair da fila, o
  // próximo pickNextMember() simplesmente recomeça do início).
  lastAssignedMemberId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       QueueMember[]
  conversations Conversation[]
  routingRules  RoutingRule[]

  @@unique([tenantId, key])
  @@map("queues")
}

model QueueMember {
  id        String   @id @default(uuid())
  tenantId  String
  queueId   String
  userId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue  Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueId, userId])
  @@map("queue_members")
}

/// Política de retenção da empresa. Existe separada de InboxSettings
/// porque apagar mensagem de cliente é decisão de compliance, não de
/// preferência de tela — e o histórico de quem mudou o quê importa.
model RetentionSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nulo = guarda pra sempre. É o padrão de propósito: apagar histórico
  /// de atendimento tem que ser escolha explícita de quem responde pela
  /// empresa, nunca um comportamento que aparece sozinho.
  keepMessagesDays Int?

  /// Quando a cota estoura, apaga o mais antigo em vez de recusar novas
  /// mensagens. Desligado, o sistema só avisa e nada é perdido.
  autoPurgeOnFull Boolean @default(false)

  lastPurgeAt      DateTime?
  lastPurgeDeleted Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("retention_settings")
}

/// Cota e vínculo com a Stripe. Guardado por tenant porque cada empresa
/// assina o próprio plano — a plataforma nunca rateia armazenamento.
model BillingAccount {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Bytes contratados. O padrão cobre bem uma operação pequena: mensagem
  /// é texto, e texto ocupa pouco — 1 GB dá na casa de milhões de linhas.
  quotaBytes BigInt @default(1073741824)

  /// Medido pelo tamanho real das linhas no Postgres, não estimado.
  usedBytes  BigInt    @default(0)
  measuredAt DateTime?

  stripeCustomerId     String?
  stripeSubscriptionId String?
  /// Rótulo do plano vigente, só pra exibição ("Grátis", "5 GB"...).
  planLabel            String  @default("Grátis")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCustomerId])
  @@map("billing_accounts")
}

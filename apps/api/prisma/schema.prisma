// Prisma schema — Fase 1 (multi-tenancy + auth) e Fase 2 (clientes, conversas, mensagens).
// Novos módulos (ai, knowledge, queues, etc.) entram nas próximas fases.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  logo      String?
  timezone  String       @default("America/Sao_Paulo")
  language  String       @default("pt-BR")
  status    TenantStatus @default(TRIAL)
  /// O que a empresa contou sobre si na primeira entrada.
  ///
  /// Fora do formulário de cadastro de propósito. Cada campo a mais na
  /// tela de criar conta derruba a conversão, e perguntar faturamento
  /// antes de a pessoa ver o produto funcionando soa como qualificação
  /// pra ligação de vendas — que é exatamente a impressão que faz alguém
  /// fechar a aba.
  ///
  /// Perguntado DEPOIS, com a conta já criada, o mesmo dado custa zero em
  /// conversão e ainda vira personalização: quem diz ter oito atendentes
  /// recebe o convite pra montar a equipe; quem atende plantão recebe a
  /// sugestão de expediente.
  ///
  /// Json porque a lista de perguntas vai mudar — e mudar pergunta de
  /// pesquisa não deveria custar migração de banco.
  profile   Json?
  /// Quando a primeira configuração foi concluída (ou dispensada).
  onboardedAt DateTime?
  /// Quem entrega as mensagens desta empresa (ver CanalProvedor).
  ///
  /// Mora aqui, e não na configuração do WhatsApp oficial, porque quem
  /// escolhe a Evolution nunca cria aquela linha — não tem token da Meta,
  /// nem número na Cloud API. Guardar a escolha lá seria guardá-la num
  /// lugar que, justamente pra metade dos casos, não existe.
  canal       CanalProvedor @default(META_CLOUD)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users              User[]
  customers          Customer[]
  conversations      Conversation[]
  messages           Message[]
  aiSettings         AiSettings?
  aiInstructions     AiInstruction[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  aiTools            AiTool[]
  tasks              Task[]
  queues             Queue[]
  quickReplies       QuickReply[]
  tags               Tag[]
  conversationTags   ConversationTag[]
  queueMembers       QueueMember[]
  routingRules       RoutingRule[]
  rolePermissions    RolePermission[]
  collectionFields   CollectionField[]
  customerNotes      CustomerNote[]
  retention          RetentionSettings?
  billing            BillingAccount?
  inboxSettings      InboxSettings?
  whatsappSettings   WhatsAppSettings?
  evolutionSettings  EvolutionSettings?
  auditLogs          AuditLog[]

  @@map("tenants")
}

/// O que se registra no histórico de auditoria.
///
/// A lista é fechada de propósito. Um campo de texto livre viraria, em
/// dois meses, vinte grafias da mesma ação e um registro impossível de
/// filtrar — que é o mesmo que não ter registro.
enum AuditAction {
  /// Mensagem apagada do painel. O conteúdo vai junto (ver `snapshot`).
  MENSAGEM_APAGADA
  CONVERSA_TRANSFERIDA
  CONVERSA_ATRIBUIDA
  CONVERSA_RESOLVIDA
  CONVERSA_REABERTA
  PRIORIDADE_ALTERADA
  IA_REATIVADA
  CONFIGURACAO_ALTERADA
  COLABORADOR_CRIADO
  COLABORADOR_ALTERADO
  COLABORADOR_REMOVIDO
  WHATSAPP_CONECTADO
  WHATSAPP_DESCONECTADO
}

/// O que a equipe fez, guardado pra quem responde pela empresa.
///
/// Existe por um pedido que qualquer dono de loja faz na primeira semana:
/// saber o que as pessoas mandam e "desmandam". Sem isto, uma mensagem
/// apagada sumia sem deixar rastro — e a única saída, quando dava briga,
/// era a palavra de um contra a do outro.
///
/// Três decisões que valem estar escritas:
///
/// 1. É SÓ ESCRITA. Não existe rota de editar nem de apagar linha daqui.
///    Um registro que o registrado consegue alterar não registra nada.
///
/// 2. Guarda o CONTEÚDO do que foi apagado, no `snapshot`. Foi escolha
///    explícita do dono do produto, e ela tem um custo que precisa ser
///    dito: o texto que alguém apagou continua existindo, legível por
///    dono e admin. Em troca, "apaguei sem querer" e "nunca mandei isso"
///    deixam de ser indecidíveis.
///
/// 3. O autor é uma referência SEM cascade de exclusão (`onDelete:
///    SetNull`): demitir alguém não pode limpar o rastro do que a pessoa
///    fez. O nome fica gravado em `actorName` justamente pra a linha
///    continuar legível depois que o usuário sumir.
model AuditLog {
  id       String @id @default(uuid())
  tenantId String

  action AuditAction

  /// Quem fez. Nulo quando foi o sistema (webhook, rotina automática).
  actorId   String?
  /// O nome de quem fez, congelado no momento da ação.
  ///
  /// Duplica o `user.name` de propósito: o histórico tem que continuar
  /// legível depois que a pessoa for removida da equipe, e tem que dizer
  /// o nome que ela tinha NA ÉPOCA, não o de agora.
  actorName String

  /// A conversa envolvida, quando a ação acontece dentro de uma.
  conversationId String?
  /// O que a linha descreve, em uma frase, já pronta pra tela.
  ///
  /// Montada na gravação e não na leitura: a frase depende de dados que
  /// podem mudar ou sumir depois (nome de fila, nome de colaborador), e
  /// remontá-la meses depois produziria um histórico que muda sozinho.
  resumo String

  /// O estado que a ação mudou ou destruiu, cru.
  ///
  /// Numa mensagem apagada é o conteúdo dela; numa configuração alterada,
  /// o antes e o depois. Json porque o formato é diferente por ação, e
  /// uma coluna por caso viraria uma tabela com trinta colunas nulas.
  snapshot Json?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// A consulta da tela: por empresa, do mais novo pro mais velho.
  @@index([tenantId, createdAt])
  /// O filtro por tipo de ação, dentro da empresa.
  @@index([tenantId, action, createdAt])
  /// "O que aconteceu NESTA conversa" — o atalho aberto pelo painel.
  @@index([tenantId, conversationId, createdAt])
  @@map("audit_logs")
}

/// Quem entrega a mensagem.
///
/// META_CLOUD é a plataforma oficial: exige verificação, análise de app e
/// modelo aprovado pra falar fora da janela de 24h, e cobra por mensagem.
/// EVOLUTION é um servidor próprio falando pelo protocolo de aparelho
/// vinculado: conecta por QR code, não custa por mensagem e não passa por
/// aprovação nenhuma — em troca, a sessão cai de vez em quando e o número
/// do cliente corre risco de bloqueio.
///
/// A escolha é comercial, não técnica, e por isso mora por empresa: dá pra
/// oferecer os dois num mesmo produto, em planos diferentes.
enum CanalProvedor {
  META_CLOUD
  EVOLUTION
}

/// Como o número entrou no sistema.
///
/// MANUAL: o cliente criou o próprio app no Meta Developers e colou os
/// dados. É o caminho de quem já estava aqui antes, e o de quem prefere
/// manter o app próprio.
///
/// EMBEDDED_SIGNUP: o cliente clicou um botão, autorizou pelo Facebook e
/// pronto — nunca abriu o Meta Developers. Exige que a PLATAFORMA seja
/// Tech Provider aprovada pela Meta; o cliente não precisa de nada.
enum WhatsAppOnboarding {
  MANUAL
  EMBEDDED_SIGNUP
}

model WhatsAppSettings {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  // ID do número na Cloud API da Meta — chega em todo webhook recebido
  // (value.metadata.phone_number_id) e é como identificamos de qual tenant
  // é uma mensagem antes mesmo de saber o tenantId, já que o webhook é
  // único pra plataforma inteira. Por isso é globalmente único, não só
  // único por tenant.
  phoneNumberId        String   @unique
  displayPhoneNumber   String?
  wabaId               String?
  accessTokenEncrypted String
  // Opcional desde a entrada por Embedded Signup: nesse caminho quem assina
  // os webhooks é o app da plataforma, com um segredo só, guardado no
  // ambiente. Preenchido apenas por quem conectou o número na mão, com app
  // próprio no Meta Developers.
  appSecretEncrypted   String?
  onboarding           WhatsAppOnboarding @default(MANUAL)
  /** Business portfolio do cliente, devolvido pelo Embedded Signup. */
  businessId           String?
  /** PIN da verificação em duas etapas, definido por nós ao registrar. */
  registrationPinEncrypted String?

  // --- Coexistência (número no aplicativo do celular E na Cloud API).
  //
  // Estes campos não são configuração: são o que a Meta nos contou pelo
  // webhook. Guardamos porque a sincronização do histórico chega picada em
  // dezenas de entregas ao longo de horas, e sem registrar o andamento não
  // há como responder "já acabou?" — nem pra tela, nem pro suporte.
  //
  // A presença de qualquer eco/contato/histórico é o que prova que a
  // coexistência está ativa; não existe endpoint pra perguntar isso.
  coexistenceSeenAt    DateTime?
  /** 0 a 100. Só do histórico anterior ao onboarding. */
  historyProgress      Int       @default(0)
  historySyncedAt      DateTime?
  historyMessages      Int       @default(0)
  /** Motivo de o histórico não vir (ex.: a empresa desligou no aplicativo). */
  historyError         String?
  contactsSyncedAt     DateTime?
  contactsCount        Int       @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

/// Em que pé está a ligação com o aparelho.
///
/// Não é enfeite de tela: na Evolution a conexão CAI sozinha — o celular
/// ficou sem bateria, o WhatsApp desvinculou o aparelho, o servidor
/// reiniciou. Enquanto a Meta ou avisa por webhook ou simplesmente
/// funciona, aqui a empresa precisa ver que parou antes de descobrir pelo
/// cliente reclamando que ninguém respondeu.
enum EvolutionEstado {
  DESCONECTADO
  AGUARDANDO_QRCODE
  CONECTADO
}

/// Em que pé está a trazida das conversas do aparelho.
///
/// Não é enfeite de tela: sem um estado gravado no servidor, a única
/// forma de a tela mostrar "trazendo as conversas" era um cronômetro no
/// navegador — que mente quando não há importação nenhuma acontecendo, e
/// que numa aba de celular congelada nunca dispara e fica girando pra
/// sempre.
enum EvolutionHistorico {
  /// Nunca houve pareamento, ou o servidor não mandou histórico nenhum.
  NUNCA
  /// O aparelho está mandando; os lotes chegam por MESSAGING_HISTORY_SET.
  IMPORTANDO
  /// O aparelho avisou que mandou o último lote.
  CONCLUIDO
}

/// A ligação com um servidor Evolution.
///
/// A Evolution fala com o WhatsApp pelo protocolo de aparelho vinculado —
/// o mesmo do WhatsApp Web. Não custa por mensagem, não passa por análise
/// da Meta e conecta lendo um QR code. Em troca não tem modelo aprovado,
/// não tem janela de 24h e o número corre risco de bloqueio; a escolha
/// entre isso e a plataforma oficial é comercial, e vive em Tenant.canal.
model EvolutionSettings {
  id       String @id @default(uuid())
  tenantId String @unique

  /// Endereço do servidor Evolution (ex.: https://evo.exemplo.com).
  ///
  /// Por empresa, e não fixo no ambiente, porque uma empresa grande pode
  /// exigir o servidor dela — e porque um servidor só, com todas as
  /// sessões juntas, transforma qualquer reinício num apagão geral.
  baseUrl         String
  /// A chave da API do servidor. Guardada cifrada, como todo segredo aqui.
  apiKeyEncrypted String

  /// O nome da sessão dentro do servidor Evolution.
  ///
  /// Único globalmente porque o webhook chega com ele e é assim que
  /// descobrimos de qual empresa é a mensagem — mesmo papel do
  /// phone_number_id no caminho oficial.
  instance String @unique

  /// O segredo que a URL de webhook carrega.
  ///
  /// A Evolution não assina as entregas como a Meta faz. Sem nada no
  /// lugar, quem descobrisse o endereço poderia inventar mensagem de
  /// cliente no painel de outra empresa. O segredo vai no caminho da URL e
  /// é conferido em tempo constante.
  webhookSecret String

  estado         EvolutionEstado @default(DESCONECTADO)
  /// O último QR code gerado, em data URI. Vale poucos segundos.
  qrCode         String?
  /// O código de oito caracteres, quando a conexão foi pedida informando
  /// o número em vez de mostrar a imagem.
  ///
  /// Existe porque no celular não dá pra escanear a própria tela — quem
  /// abre o painel pelo telefone precisava de um segundo aparelho. Vive
  /// como o `qrCode`: nasce ao pedir a conexão e some quando o pareamento
  /// acontece.
  pairingCode    String?
  /// O número que atendeu ao QR code, do jeito que o WhatsApp informou.
  connectedPhone String?
  /// Quando o servidor confirmou a sessão de pé pela última vez.
  lastSeenAt     DateTime?
  /// O motivo da última queda, pra tela dizer o que aconteceu.
  lastError      String?

  /// Em que pé está a importação das conversas que já estavam no aparelho.
  historicoEstado      EvolutionHistorico @default(NUNCA)
  /// Quantas mensagens vieram do aparelho na importação atual.
  historicoMensagens   Int                @default(0)
  /// Quando o pareamento pediu o histórico.
  ///
  /// É o que permite desistir de esperar: ninguém garante que o aparelho
  /// vá mandar o lote final, e sem uma hora de início "importando" não
  /// tem como acabar. Ver `HISTORICO_PACIENCIA_MS`.
  historicoIniciadoEm  DateTime?
  /// Quando o aparelho avisou que mandou tudo.
  historicoConcluidoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("evolution_settings")
}

model User {
  id                 String     @id @default(uuid())
  tenantId           String
  name               String
  email              String
  passwordHash       String
  role               UserRole   @default(AGENT)
  avatar             String?
  status             UserStatus @default(ACTIVE)
  // Conta criada pelo dono com senha temporária: o primeiro login obriga a
  // pessoa a definir a própria senha, então a senha que o dono viu deixa
  // de valer e ninguém além do titular a conhece.
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]
  queueMemberships      QueueMember[]
  routingRules          RoutingRule[]
  customerNotes         CustomerNote[]
  auditLogs             AuditLog[]     @relation("AuditActor")

  // Email é único globalmente (não só por tenant): simplifica o login, que não
  // exige saber a qual empresa o usuário pertence antes de autenticar.
  // Cada usuário pertence a exatamente um tenant no MVP.
  @@unique([email])
  @@index([tenantId])
  @@map("users")
}

model Customer {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  phone      String
  email      String?
  externalId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  notes         CustomerNote[]

  // Telefone é a chave de identificação de um cliente dentro de um tenant
  // (é por onde ele chega pelo WhatsApp), mas o mesmo telefone pode ser
  // cliente de várias empresas diferentes na plataforma.
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

// Preferências de atendimento da empresa, separadas das credenciais do
// canal: valem pra qualquer canal e são o tipo de coisa que o dono mexe
// sem precisar tocar em token nenhum.
enum QueueVisibility {
  ALL
  OWN_QUEUES
}

/// O que fazer com o áudio que o cliente manda, quando quem atende é
/// gente.
///
/// Com a IA respondendo a transcrição SEMPRE acontece — sem ouvir, ela não
/// tem o que responder, e isso não é preferência. Para o atendente humano
/// é: ele consegue ouvir, então transcrever vira conveniência que custa
/// uma chamada ao modelo por áudio.
///
/// DESLIGADA nem oferece o botão. SOB_DEMANDA deixa a escolha com quem
/// atende, áudio a áudio. AUTOMATICA transcreve tudo na chegada — é a
/// escolha de quem prefere ler a ouvir, trabalha sem fone, ou precisa do
/// histórico pesquisável por inteiro.
enum TranscricaoDeAudio {
  DESLIGADA
  SOB_DEMANDA
  AUTOMATICA
}

model InboxSettings {
  id               String   @id @default(uuid())
  tenantId         String   @unique

  /// Ver TranscricaoDeAudio. O padrão deixa a escolha com quem atende:
  /// ligar tudo sem avisar cobraria do dono uma chamada ao modelo por
  /// áudio recebido, e desligar esconderia um recurso que ele nem saberia
  /// que existe.
  transcricaoDeAudio TranscricaoDeAudio @default(SOB_DEMANDA)
  // Confirmação de leitura: quando desligada, abrir a conversa no painel
  // não acende o tique azul no aparelho do cliente. É escolha da empresa —
  // tem negócio que prefere não revelar que leu e ainda não respondeu.
  sendReadReceipts Boolean  @default(true)
  // Aviso automático ao resolver: sem isso o cliente fica sem saber que o
  // atendimento foi encerrado e continua esperando resposta.
  notifyOnResolve  Boolean  @default(true)
  resolveMessage   String   @default("Atendimento encerrado por aqui. Se precisar de mais alguma coisa, é só mandar mensagem que a gente volta a te atender.")
  // Agrupar conversas do mesmo cliente: quando ligado, quem volta a
  // escrever depois de um assunto resolvido cai na MESMA conversa, com o
  // histórico anterior à vista, em vez de abrir um card novo do zero.
  // Desligado, cada assunto vira um atendimento separado — que é o que
  // uma operação com métrica por chamado costuma querer.
  /// Deixa responder numa conversa já encerrada. Ligado, enviar reabre o
  /// atendimento automaticamente — é o que a maioria espera, porque o
  /// cliente do outro lado não vê "encerrado", vê uma conversa de WhatsApp.
  /// Desligado, o compositor fica travado e é preciso reabrir de propósito.
  allowSendWhenResolved Boolean @default(true)

  groupByCustomer  Boolean  @default(true)
  // Janela em horas pro reagrupamento. Passou disso, o assunto é outro e
  // a conversa nova começa limpa.
  groupWindowHours Int      @default(72)
  /// Encerra sozinho o que ficou parado.
  ///
  /// LIGADO por padrão, e a razão é dinheiro: passadas 24h sem mensagem do
  /// cliente, a janela de atendimento do WhatsApp fecha e responder passa a
  /// exigir modelo aprovado — que é burocrático e COBRADO por mensagem.
  /// Conversa esquecida em aberto é uma dessas contas esperando pra
  /// acontecer, e quem desliga o recurso deveria estar escolhendo pagar,
  /// não descobrindo depois que pagou.
  ///
  /// O padrão de 20 horas encerra com folga antes das 24, enquanto ainda dá
  /// tempo de alguém reabrir de graça.
  autoCloseIdle    Boolean  @default(true)
  autoCloseHours   Int      @default(20)
  /// Avisa o cliente antes de encerrar por inatividade.
  ///
  /// Sem o aviso, a conversa some do lado de cá e o cliente fica achando
  /// que ainda tem alguém do outro lado — ele volta dias depois cobrando
  /// uma resposta que, pro sistema, já era assunto encerrado. Uma frase
  /// resolve isso e ainda convida a voltar.
  ///
  /// Só é enviado dentro da janela de 24h (ver AutoCloseService): fora
  /// dela a Meta recusa texto livre, e insistir seria pagar por um aviso
  /// de despedida.
  autoCloseNotify  Boolean  @default(true)
  autoCloseMessage String   @default("Olá! Percebemos que faz um tempo que você não interage nesta conversa e, para manter nosso atendimento organizado, vamos encerrá-la por aqui. Se precisar de ajuda novamente, é só nos chamar. Será um prazer atender você!")
  // Assina a mensagem com o nome de quem respondeu ("*Renan:*" em negrito,
  // antes do texto). Desligado por padrão porque é decisão de imagem: tem
  // empresa que quer que o cliente saiba com quem falou, e tem empresa que
  // prefere falar como uma voz só.
  showAgentName    Boolean  @default(false)
  // Quem enxerga o quê no Inbox. ALL: todo mundo vê tudo, que é o certo pra
  // equipe pequena. OWN_QUEUES: cada um vê só os setores de que participa —
  // o financeiro não abre conversa do jurídico. Dono e admin veem tudo nos
  // dois modos, senão não dá pra chefiar.
  queueVisibility  QueueVisibility @default(ALL)
  /// Horário de atendimento da empresa, no fuso dela (Tenant.timezone).
  ///
  /// Formato: as faixas de cada dia da semana, com domingo em 0 — o mesmo
  /// índice do `getDay()` do JavaScript.
  ///
  ///     { "1": [["08:00","12:00"],["13:00","18:00"]], "2": [...] }
  ///
  /// São faixas, e não um par abre/fecha, porque o almoço existe: comércio
  /// que fecha das 12h às 14h é o caso comum.
  ///
  /// Nulo ou vazio significa "não configurado", e aí a empresa atende
  /// sempre — que é como o sistema se comportava antes disto existir.
  /// Ligar e desligar o recurso é preencher e limpar esta coluna; um
  /// booleano separado seria uma segunda fonte de verdade capaz de
  /// discordar dela.
  ///
  /// A leitura passa sempre por `lerExpediente` (horario-comercial.ts):
  /// coluna Json não tem garantia de forma, e a validação mora num lugar só.
  businessHours    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("inbox_settings")
}

/// Anotação interna sobre um cliente. Nunca vai pro cliente.
///
/// Nasceu de uma necessidade concreta do atendimento: "Nilma Transportes,
/// aguardando prazo de coleta das informações". Isso não é mensagem, não é
/// tarefa do sistema e não pertence a uma conversa específica — é memória
/// da relação com aquele cliente, que precisa sobreviver ao fim do assunto
/// e estar à mão de quem pegar a próxima conversa dele.
///
/// Uma anotação vira pendência marcando `isPending`. A diferença é só de
/// estado: pendência aparece em destaque enquanto não for concluída;
/// anotação comum é registro e pronto.
model CustomerNote {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  /// Quem escreveu. Nulo se a pessoa saiu da empresa — a anotação continua
  /// valendo mesmo sem o autor.
  authorId   String?
  content    String
  isPending  Boolean   @default(false)
  dueAt      DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId, createdAt])
  @@map("customer_notes")
}

enum ConversationChannel {
  INTERNAL
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_AGENT
  RESOLVED
  CLOSED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AiMode {
  AI_ACTIVE
  HUMAN_ACTIVE
  AI_ASSIST
  PAUSED
}

model Conversation {
  id                String               @id @default(uuid())
  tenantId          String
  customerId        String
  channel           ConversationChannel  @default(INTERNAL)
  status            ConversationStatus   @default(OPEN)
  assignedUserId    String?
  queueId           String?
  aiMode            AiMode               @default(AI_ACTIVE)
  priority          ConversationPriority @default(NORMAL)
  // Preenchidos pela ferramenta transferToQueue — o "handoff inteligente"
  // do escopo original: por que foi transferida, resumo pra quem for
  // atender não perder contexto, e dados que a IA já coletou do cliente.
  escalationReason  String?
  escalationSummary String?
  collectedData     Json?
  // Não lidas da caixa compartilhada: sobe a cada mensagem do cliente e
  // zera quando alguém abre a conversa. É por conversa e não por usuário
  // porque o Inbox é de time — quando um atendente lê, a conversa está
  // lida pra empresa, igual a uma caixa de e-mail compartilhada.
  unreadCount       Int                  @default(0)

  /// Falso enquanto o responsável indicado ainda não confirmou. Só o
  /// direcionamento automático (regra ou trava da IA) cria conversa nesse
  /// estado: a máquina sugere, a pessoa aceita. Quem assume pelo botão já
  /// entra aceito, porque a escolha foi dela.
  assignmentAccepted Boolean             @default(true)
  lastMessageAt     DateTime?

  /// Desde quando o CLIENTE está esperando resposta.
  ///
  /// Não é o mesmo que `lastMessageAt`, e a diferença é o ponto: a lista
  /// ordenada por mensagem mais recente empurra pra baixo justamente quem
  /// escreveu, não foi respondido e desistiu de insistir. Quem cobra sobe;
  /// quem espera quieto afunda — e é o segundo que fica sem atendimento.
  ///
  /// Marca a primeira mensagem do cliente que ainda não teve resposta da
  /// empresa, e volta a ser nulo quando alguém (ou a IA) responde. Nulo
  /// significa "a bola não está com a gente".
  waitingSince      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  queue        Queue?    @relation(fields: [queueId], references: [id], onDelete: SetNull)
  messages     Message[]
  tasks        Task[]
  tags         ConversationTag[]

  @@index([tenantId, status])
  // Ordenação padrão da lista do Inbox (mais recente primeiro) —
  // sem isso o Postgres ordena a tabela toda a cada página.
  @@index([tenantId, lastMessageAt(sort: Desc)])
  // Ordenação da fila de atendimento (quem espera há mais tempo primeiro).
  // Só as que estão esperando têm valor aqui, então o índice é pequeno
  // mesmo numa base grande.
  @@index([tenantId, waitingSince])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([queueId])
  @@map("conversations")
}

enum MessageSenderType {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  OTHER
}

// Ciclo de vida de entrega de uma mensagem que a empresa mandou. Só faz
// sentido pra mensagens de saída em canais que reportam entrega (hoje só
// WhatsApp) — mensagem de cliente entra direto como SENT e fica assim.
enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id             String            @id @default(uuid())
  tenantId       String
  conversationId String
  senderType     MessageSenderType
  senderId       String?
  content        String
  messageType    MessageType       @default(TEXT)
  status         MessageStatus     @default(SENT)
  // ID da mensagem na Meta (wamid...), devolvido no envio. É por ele que
  // os webhooks de status depois encontram a linha certa pra atualizar.
  externalId     String?
  metadata       Json?
  // ID da mídia na Meta, espelhado pra fora do metadata.
  //
  // Ele continua dentro do JSON (junto do mime, nome e chave do bucket),
  // mas o proxy de anexo procura a mensagem POR ele em toda abertura de
  // conversa e em todo arquivamento vindo do webhook. Buscar por caminho
  // dentro de Json não usa índice: varria a tabela de mensagens inteira do
  // tenant, e essa tabela é a que mais cresce no sistema. Como coluna, a
  // busca é um índice direto.
  mediaId        String?
  // Resposta citada: no WhatsApp o cliente pode responder uma mensagem
  // específica, e sem isso a conversa perde o fio quando ele responde algo
  // de cinco mensagens atrás.
  replyToId      String?
  // Reações (emoji) na mensagem, como {"👍": ["5511..."]}. Guardadas na
  // própria mensagem reagida, não como mensagem nova — é assim que a Meta
  // manda e é assim que faz sentido exibir.
  /// O que foi falado no áudio, em texto.
  ///
  /// Guardada, e não gerada a cada abertura, por três motivos que se
  /// somam: transcrever custa uma chamada ao modelo por áudio, o resultado
  /// não muda (a gravação é a mesma), e é ela que a busca dentro da
  /// conversa precisa encontrar — sem isso, o que o cliente disse falando
  /// some de toda pesquisa.
  transcricao    String?
  reactions      Json?
  // Quando alguém apagou a mensagem no painel. Apagamento é lógico: a
  // linha permanece com o conteúdo, porque histórico de atendimento é
  // prova — em cobrança, reclamação ou processo, "sumiu" e "nunca existiu"
  // são coisas diferentes. O painel esconde o conteúdo e mostra a tarja de
  // apagada; quem apagou e quando ficam registrados.
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime          @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([tenantId])
  @@index([conversationId, createdAt])
  @@index([externalId])
  // Composto e nesta ordem: a busca sempre chega com o tenant já fixado
  // pela extensão de isolamento, então o filtro mais seletivo vem primeiro.
  @@index([tenantId, mediaId])
  @@map("messages")
}

// Tipo do dado que a IA precisa coletar — o tipo é o que permite validar
// e, no futuro, formatar (CPF, telefone) em vez de aceitar texto solto.
enum CollectionFieldType {
  TEXT
  EMAIL
  PHONE
  DOCUMENT
  DATE
  NUMBER
}

// Onde o valor coletado é gravado. NAME e EMAIL sobem pro cadastro do
// cliente (deixando o contato com o nome de verdade em vez do que veio do
// perfil do WhatsApp); METADATA fica no bolso livre do cliente.
enum CollectionFieldTarget {
  NAME
  EMAIL
  METADATA
}

// Campo que a IA é obrigada a coletar antes de transferir ou encerrar.
// Diferente das instruções em texto livre: aqui o sistema sabe o que
// falta e cobra, em vez de torcer pra o modelo lembrar.
model CollectionField {
  id          String                @id @default(uuid())
  tenantId    String
  key         String
  label       String
  description String?
  type        CollectionFieldType   @default(TEXT)
  target      CollectionFieldTarget @default(METADATA)
  required    Boolean               @default(true)
  order       Int                   @default(0)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, active])
  @@map("collection_fields")
}

enum AiTone {
  PROFESSIONAL
  FRIENDLY
  CASUAL
  OBJECTIVE
  WARM
}

// Provedores de LLM suportados. Cada um novo (OpenAI, Anthropic...) só
// precisa de um adapter em modules/ai/providers — não muda esse enum de
// lugar nenhum além do binding de DI.
enum AiProviderKind {
  GEMINI
}

// Quanto a IA pode guardar sobre um cliente entre uma conversa e outra.
// É decisão do dono da empresa, não da IA: NONE desliga a ferramenta de
// memória por completo, IMPORTANT_ONLY deixa guardar só o que é preciso
// pra atender de novo (ex: "é advogado", "prefere ser chamado de Dr."),
// e FULL libera detalhes gerais que aparecerem na conversa.
enum AiMemoryMode {
  NONE
  IMPORTANT_ONLY
  FULL
}

// Identidade, comportamento e credencial de IA — uma linha por tenant
// (1:1). Criada com valores padrão junto do tenant no registro (ver
// AuthService.register). Cada empresa usa a própria API key: nunca
// compartilhado entre tenants, nunca em texto puro (ver EncryptionService).
model AiSettings {
  id                 String         @id @default(uuid())
  tenantId           String         @unique
  active             Boolean        @default(true)
  aiName             String         @default("Assistente")
  tone               AiTone         @default(PROFESSIONAL)
  customInstructions String?
  provider           AiProviderKind @default(GEMINI)
  apiKeyEncrypted    String?
  model              String?
  memoryMode         AiMemoryMode   @default(IMPORTANT_ONLY)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// Instrução em linguagem natural que o dono ensina pra IA (ver seção
// "Ensinar a IA" do produto). Entram no prompt ordenadas por prioridade.
model AiInstruction {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  content   String
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("ai_instructions")
}

enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

// Um documento enviado (PDF, DOCX, TXT, CSV, XLSX). O texto extraído vira
// KnowledgeChunk — este model só guarda metadado e status do processamento,
// não o arquivo original (ver decisão de arquitetura no KnowledgeService).
model KnowledgeDocument {
  id           String                  @id @default(uuid())
  tenantId     String
  title        String
  fileName     String
  mimeType     String
  status       KnowledgeDocumentStatus @default(PROCESSING)
  errorMessage String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
  @@map("knowledge_documents")
}

// Pedaço de texto extraído + embedding pra busca semântica (pgvector). O
// campo embedding é Unsupported porque o Prisma Client não modela o tipo
// `vector` nativamente — toda leitura/escrita dele passa por SQL raw
// (ver KnowledgeService), o que também significa que a extensão central de
// isolamento por tenant NÃO protege essas queries automaticamente: todo
// SQL raw aqui precisa filtrar tenantId manualmente, sempre.
model KnowledgeChunk {
  id         String                      @id @default(uuid())
  tenantId   String
  documentId String
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

enum AiToolPermission {
  ALLOW
  DENY
  REQUIRES_APPROVAL
}

// Configuração de uma ferramenta nativa pra este tenant. `key` casa com a
// implementação fixa no registro (ver AiToolsService) — o catálogo de
// ferramentas em si é código, só a permissão/liga-desliga é por tenant.
model AiTool {
  id         String           @id @default(uuid())
  tenantId   String
  key        String
  enabled    Boolean          @default(false)
  permission AiToolPermission @default(REQUIRES_APPROVAL)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("ai_tools")
}

// Regra de "quem atende o quê": o dono descreve o assunto em português e
// escolhe o destino (uma pessoa específica ou uma fila). A descrição é o
// que a IA lê pra escolher a regra certa — por isso ela é texto livre e
// não uma lista fixa de categorias.
model RoutingRule {
  id            String               @id @default(uuid())
  tenantId      String
  key           String
  name          String
  // Quando usar esta regra, em linguagem natural. Vai pro prompt da IA.
  subject       String
  // Prioridade mínima pra regra valer. NORMAL (padrão) = vale sempre;
  // URGENT = só entra quando a conversa foi classificada como urgente,
  // que é como se monta um plantão sem atrapalhar o fluxo do dia a dia.
  minPriority   ConversationPriority @default(NORMAL)
  // Destino: uma pessoa OU uma fila. Pessoa tem precedência quando os
  // dois estão preenchidos.
  targetUserId  String?
  targetQueueId String?
  active        Boolean              @default(true)
  priorityOrder Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUser  User?  @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  targetQueue Queue? @relation(fields: [targetQueueId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([tenantId, active])
  @@map("routing_rules")
}

// O que cada papel pode fazer, ajustável pelo dono. A linha só existe
// quando o dono mexeu no padrão — a ausência significa "vale o padrão do
// código" (ver PERMISSION_DEFAULTS), então ligar o sistema não precisa
// semear nada e um recurso novo já nasce com um padrão sensato.
model RolePermission {
  id        String   @id @default(uuid())
  tenantId  String
  role      UserRole
  key       String
  allowed   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, key])
  @@index([tenantId])
  @@map("role_permissions")
}

enum TaskStatus {
  OPEN
  DONE
}

// Tarefa de acompanhamento pra equipe humana — criada pela ferramenta
// createTask da IA, ou (no futuro) manualmente por um atendente.
model Task {
  id             String     @id @default(uuid())
  tenantId       String
  conversationId String?
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  createdByAi    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([conversationId])
  @@map("tasks")
}

// Fila/departamento pro qual a IA transfere um atendimento (ver
// AiToolsService.transferToQueue). `key` é o identificador estável que a
// IA usa pra escolher a fila certa — dado como enum dinâmico na
// declaração da ferramenta, nunca texto livre adivinhado pelo modelo.
model Queue {
  id                   String   @id @default(uuid())
  tenantId             String
  key                  String
  name                 String
  description          String?
  // Ponteiro do rodízio: id do último membro que recebeu uma conversa
  // desta fila. Sem relação formal de propósito — é só um bookmark, não
  // precisa de integridade referencial (se o membro sair da fila, o
  // próximo pickNextMember() simplesmente recomeça do início).
  lastAssignedMemberId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       QueueMember[]
  conversations Conversation[]
  routingRules  RoutingRule[]

  @@unique([tenantId, key])
  @@map("queues")
}

/// Um texto pronto que o atendente insere no compositor por um atalho.
///
/// Quem atende escreve as mesmas cinco frases o dia inteiro — "Bom dia! Em
/// que posso ajudar?", os dados bancários, o endereço. Digitar tudo de novo
/// a cada conversa é o trabalho manual mais óbvio que sobra depois que a IA
/// pega o resto.
///
/// O `shortcut` é o que se digita depois da barra ("/bomdia"), e por isso é
/// único por empresa: dois atalhos iguais deixariam a escolha no ar.
/// Etiqueta de conversa ("Orçamento", "Reclamação", "Segunda via").
///
/// Serve pra três coisas ao mesmo tempo: quem atende vê do que se trata
/// antes de abrir, o filtro separa por assunto, e o relatório passa a ter
/// uma dimensão que ninguém precisou programar.
///
/// A cor é escolhida de uma paleta fechada e guardada pelo NOME do tom
/// ("ambar"), não pelo código hexadecimal: o painel tem tema claro e
/// escuro, e um #FFCC00 cravado aqui ficaria ilegível num dos dois.
model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("cinza")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  /// Dois nomes iguais na mesma empresa viram duas etiquetas que ninguém
  /// distingue na hora de escolher.
  @@unique([tenantId, name])
  @@map("tags")
}

/// Ligação entre conversa e etiqueta.
///
/// Explícita, e não a relação implícita do Prisma: a tabela do meio precisa
/// do tenantId como as outras, senão ela fica de fora do isolamento por
/// empresa que o resto do sistema aplica.
model ConversationTag {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([tenantId, tagId])
  @@map("conversation_tags")
}

model QuickReply {
  id        String   @id @default(uuid())
  tenantId  String
  shortcut  String
  /// Rótulo curto pra lista. Vazio, a própria primeira linha do texto serve.
  title     String?
  content   String
  /// Quantas vezes já foi usada. Ordena a lista pelo que a equipe de fato
  /// usa, em vez de por ordem de cadastro — depois de uma semana, o atalho
  /// certo é o primeiro sem ninguém ter organizado nada.
  usageCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@index([tenantId, usageCount])
  @@map("quick_replies")
}

model QueueMember {
  id        String   @id @default(uuid())
  tenantId  String
  queueId   String
  userId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue  Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueId, userId])
  @@map("queue_members")
}

/// Política de retenção da empresa. Existe separada de InboxSettings
/// porque apagar mensagem de cliente é decisão de compliance, não de
/// preferência de tela — e o histórico de quem mudou o quê importa.
model RetentionSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nulo = guarda pra sempre. É o padrão de propósito: apagar histórico
  /// de atendimento tem que ser escolha explícita de quem responde pela
  /// empresa, nunca um comportamento que aparece sozinho.
  keepMessagesDays Int?

  /// Quando a cota estoura, apaga o mais antigo em vez de recusar novas
  /// mensagens. Desligado, o sistema só avisa e nada é perdido.
  autoPurgeOnFull Boolean @default(false)

  lastPurgeAt      DateTime?
  lastPurgeDeleted Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("retention_settings")
}

/// Cota e vínculo com a Stripe. Guardado por tenant porque cada empresa
/// assina o próprio plano — a plataforma nunca rateia armazenamento.
model BillingAccount {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Bytes contratados. O padrão cobre bem uma operação pequena: mensagem
  /// é texto, e texto ocupa pouco — 1 GB dá na casa de milhões de linhas.
  quotaBytes BigInt @default(1073741824)

  /// Medido pelo tamanho real das linhas no Postgres, não estimado.
  usedBytes  BigInt    @default(0)
  measuredAt DateTime?

  stripeCustomerId     String?
  stripeSubscriptionId String?
  /// Rótulo do plano vigente, só pra exibição ("Grátis", "5 GB"...).
  planLabel            String  @default("Grátis")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCustomerId])
  @@map("billing_accounts")
}

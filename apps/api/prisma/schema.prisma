// Prisma schema — Fase 1 (multi-tenancy + auth) e Fase 2 (clientes, conversas, mensagens).
// Novos módulos (ai, knowledge, queues, etc.) entram nas próximas fases.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  logo      String?
  timezone  String       @default("America/Sao_Paulo")
  language  String       @default("pt-BR")
  status    TenantStatus @default(TRIAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users              User[]
  customers          Customer[]
  conversations      Conversation[]
  messages           Message[]
  aiSettings         AiSettings?
  aiInstructions     AiInstruction[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  aiTools            AiTool[]
  tasks              Task[]
  queues             Queue[]
  queueMembers       QueueMember[]
  routingRules       RoutingRule[]
  whatsappSettings   WhatsAppSettings?

  @@map("tenants")
}

model WhatsAppSettings {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  // ID do número na Cloud API da Meta — chega em todo webhook recebido
  // (value.metadata.phone_number_id) e é como identificamos de qual tenant
  // é uma mensagem antes mesmo de saber o tenantId, já que o webhook é
  // único pra plataforma inteira. Por isso é globalmente único, não só
  // único por tenant.
  phoneNumberId        String   @unique
  displayPhoneNumber   String?
  wabaId               String?
  accessTokenEncrypted String
  appSecretEncrypted   String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         UserRole   @default(AGENT)
  avatar       String?
  status       UserStatus @default(ACTIVE)
  // Conta criada pelo dono com senha temporária: o primeiro login obriga a
  // pessoa a definir a própria senha, então a senha que o dono viu deixa
  // de valer e ninguém além do titular a conhece.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]
  queueMemberships      QueueMember[]
  routingRules          RoutingRule[]

  // Email é único globalmente (não só por tenant): simplifica o login, que não
  // exige saber a qual empresa o usuário pertence antes de autenticar.
  // Cada usuário pertence a exatamente um tenant no MVP.
  @@unique([email])
  @@index([tenantId])
  @@map("users")
}

model Customer {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  phone      String
  email      String?
  externalId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  // Telefone é a chave de identificação de um cliente dentro de um tenant
  // (é por onde ele chega pelo WhatsApp), mas o mesmo telefone pode ser
  // cliente de várias empresas diferentes na plataforma.
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

enum ConversationChannel {
  INTERNAL
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_AGENT
  RESOLVED
  CLOSED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AiMode {
  AI_ACTIVE
  HUMAN_ACTIVE
  AI_ASSIST
  PAUSED
}

model Conversation {
  id                String               @id @default(uuid())
  tenantId          String
  customerId        String
  channel           ConversationChannel  @default(INTERNAL)
  status            ConversationStatus   @default(OPEN)
  assignedUserId    String?
  queueId           String?
  aiMode            AiMode               @default(AI_ACTIVE)
  priority          ConversationPriority @default(NORMAL)
  // Preenchidos pela ferramenta transferToQueue — o "handoff inteligente"
  // do escopo original: por que foi transferida, resumo pra quem for
  // atender não perder contexto, e dados que a IA já coletou do cliente.
  escalationReason  String?
  escalationSummary String?
  collectedData     Json?
  // Não lidas da caixa compartilhada: sobe a cada mensagem do cliente e
  // zera quando alguém abre a conversa. É por conversa e não por usuário
  // porque o Inbox é de time — quando um atendente lê, a conversa está
  // lida pra empresa, igual a uma caixa de e-mail compartilhada.
  unreadCount       Int                  @default(0)
  lastMessageAt     DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  queue        Queue?    @relation(fields: [queueId], references: [id], onDelete: SetNull)
  messages     Message[]
  tasks        Task[]

  @@index([tenantId, status])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([queueId])
  @@map("conversations")
}

enum MessageSenderType {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  OTHER
}

// Ciclo de vida de entrega de uma mensagem que a empresa mandou. Só faz
// sentido pra mensagens de saída em canais que reportam entrega (hoje só
// WhatsApp) — mensagem de cliente entra direto como SENT e fica assim.
enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id             String            @id @default(uuid())
  tenantId       String
  conversationId String
  senderType     MessageSenderType
  senderId       String?
  content        String
  messageType    MessageType       @default(TEXT)
  status         MessageStatus     @default(SENT)
  // ID da mensagem na Meta (wamid...), devolvido no envio. É por ele que
  // os webhooks de status depois encontram a linha certa pra atualizar.
  externalId     String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId, createdAt])
  @@index([externalId])
  @@map("messages")
}

enum AiTone {
  PROFESSIONAL
  FRIENDLY
  CASUAL
  OBJECTIVE
  WARM
}

// Provedores de LLM suportados. Cada um novo (OpenAI, Anthropic...) só
// precisa de um adapter em modules/ai/providers — não muda esse enum de
// lugar nenhum além do binding de DI.
enum AiProviderKind {
  GEMINI
}

// Quanto a IA pode guardar sobre um cliente entre uma conversa e outra.
// É decisão do dono da empresa, não da IA: NONE desliga a ferramenta de
// memória por completo, IMPORTANT_ONLY deixa guardar só o que é preciso
// pra atender de novo (ex: "é advogado", "prefere ser chamado de Dr."),
// e FULL libera detalhes gerais que aparecerem na conversa.
enum AiMemoryMode {
  NONE
  IMPORTANT_ONLY
  FULL
}

// Identidade, comportamento e credencial de IA — uma linha por tenant
// (1:1). Criada com valores padrão junto do tenant no registro (ver
// AuthService.register). Cada empresa usa a própria API key: nunca
// compartilhado entre tenants, nunca em texto puro (ver EncryptionService).
model AiSettings {
  id                 String         @id @default(uuid())
  tenantId           String         @unique
  active             Boolean        @default(true)
  aiName             String         @default("Assistente")
  tone               AiTone         @default(PROFESSIONAL)
  customInstructions String?
  provider           AiProviderKind @default(GEMINI)
  apiKeyEncrypted    String?
  model              String?
  memoryMode         AiMemoryMode   @default(IMPORTANT_ONLY)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// Instrução em linguagem natural que o dono ensina pra IA (ver seção
// "Ensinar a IA" do produto). Entram no prompt ordenadas por prioridade.
model AiInstruction {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  content   String
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("ai_instructions")
}

enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

// Um documento enviado (PDF, DOCX, TXT, CSV, XLSX). O texto extraído vira
// KnowledgeChunk — este model só guarda metadado e status do processamento,
// não o arquivo original (ver decisão de arquitetura no KnowledgeService).
model KnowledgeDocument {
  id           String                  @id @default(uuid())
  tenantId     String
  title        String
  fileName     String
  mimeType     String
  status       KnowledgeDocumentStatus @default(PROCESSING)
  errorMessage String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
  @@map("knowledge_documents")
}

// Pedaço de texto extraído + embedding pra busca semântica (pgvector). O
// campo embedding é Unsupported porque o Prisma Client não modela o tipo
// `vector` nativamente — toda leitura/escrita dele passa por SQL raw
// (ver KnowledgeService), o que também significa que a extensão central de
// isolamento por tenant NÃO protege essas queries automaticamente: todo
// SQL raw aqui precisa filtrar tenantId manualmente, sempre.
model KnowledgeChunk {
  id         String                      @id @default(uuid())
  tenantId   String
  documentId String
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

enum AiToolPermission {
  ALLOW
  DENY
  REQUIRES_APPROVAL
}

// Configuração de uma ferramenta nativa pra este tenant. `key` casa com a
// implementação fixa no registro (ver AiToolsService) — o catálogo de
// ferramentas em si é código, só a permissão/liga-desliga é por tenant.
model AiTool {
  id         String           @id @default(uuid())
  tenantId   String
  key        String
  enabled    Boolean          @default(false)
  permission AiToolPermission @default(REQUIRES_APPROVAL)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("ai_tools")
}

// Regra de "quem atende o quê": o dono descreve o assunto em português e
// escolhe o destino (uma pessoa específica ou uma fila). A descrição é o
// que a IA lê pra escolher a regra certa — por isso ela é texto livre e
// não uma lista fixa de categorias.
model RoutingRule {
  id          String   @id @default(uuid())
  tenantId    String
  key         String
  name        String
  // Quando usar esta regra, em linguagem natural. Vai pro prompt da IA.
  subject     String
  // Prioridade mínima pra regra valer. NORMAL (padrão) = vale sempre;
  // URGENT = só entra quando a conversa foi classificada como urgente,
  // que é como se monta um plantão sem atrapalhar o fluxo do dia a dia.
  minPriority ConversationPriority @default(NORMAL)
  // Destino: uma pessoa OU uma fila. Pessoa tem precedência quando os
  // dois estão preenchidos.
  targetUserId  String?
  targetQueueId String?
  active      Boolean  @default(true)
  priorityOrder Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUser  User?   @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  targetQueue Queue?  @relation(fields: [targetQueueId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([tenantId, active])
  @@map("routing_rules")
}

enum TaskStatus {
  OPEN
  DONE
}

// Tarefa de acompanhamento pra equipe humana — criada pela ferramenta
// createTask da IA, ou (no futuro) manualmente por um atendente.
model Task {
  id             String     @id @default(uuid())
  tenantId       String
  conversationId String?
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  createdByAi    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([conversationId])
  @@map("tasks")
}

// Fila/departamento pro qual a IA transfere um atendimento (ver
// AiToolsService.transferToQueue). `key` é o identificador estável que a
// IA usa pra escolher a fila certa — dado como enum dinâmico na
// declaração da ferramenta, nunca texto livre adivinhado pelo modelo.
model Queue {
  id                   String   @id @default(uuid())
  tenantId             String
  key                  String
  name                 String
  description          String?
  // Ponteiro do rodízio: id do último membro que recebeu uma conversa
  // desta fila. Sem relação formal de propósito — é só um bookmark, não
  // precisa de integridade referencial (se o membro sair da fila, o
  // próximo pickNextMember() simplesmente recomeça do início).
  lastAssignedMemberId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       QueueMember[]
  conversations Conversation[]
  routingRules  RoutingRule[]

  @@unique([tenantId, key])
  @@map("queues")
}

model QueueMember {
  id        String   @id @default(uuid())
  tenantId  String
  queueId   String
  userId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue  Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueId, userId])
  @@map("queue_members")
}
